# BuildPermit AI - Backend Environment Configuration

PROJECT_NAME="BuildPermit AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Change in Production)
SECRET_KEY="buildpermit-ai-dev-secret-key-change-in-prod-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# SQLite (Zero-configuration local default):
DATABASE_URL="sqlite:///./buildpermit.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql+psycopg2://buildpermit:buildpermit_pass@localhost:5432/buildpermit_db"

# Local AI / Ollama Integration
AI_ENABLED=true
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"
AI_REQUEST_TIMEOUT=60

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_PAGES_PER_DOCUMENT=150
